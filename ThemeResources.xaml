<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Light Theme Resources -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="White" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="White" />
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="Black" />
    <SolidColorBrush x:Key="HeaderForegroundBrush" Color="Black" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D0D0D0" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="Black" />
    <SolidColorBrush x:Key="ListItemBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ListItemForegroundBrush" Color="Black" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="Black" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D0D0D0" />
    <SolidColorBrush x:Key="ButtonDisabledBackgroundBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="ButtonDisabledForegroundBrush" Color="#A0A0A0" />
    
</ResourceDictionary>