<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Dark Theme Resources -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="White" />
    <SolidColorBrush x:Key="HeaderForegroundBrush" Color="White" />
    <SolidColorBrush x:Key="BorderBrush" Color="#404040" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#151515" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="White" />
    <SolidColorBrush x:Key="ListItemBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ListItemForegroundBrush" Color="White" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="White" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#555555" />
    <SolidColorBrush x:Key="ButtonDisabledBackgroundBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="ButtonDisabledForegroundBrush" Color="#707070" />
    
</ResourceDictionary>